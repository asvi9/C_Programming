=========================== 5. Develop a program to print addition of 2  numbers (with scanf). =====================


#include <stdio.h>

int main()
{
    int a, b, sum;

    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);

    sum = a + b;

    printf("Addition = %d", sum);

    return 0;
}
