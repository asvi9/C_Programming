#include <stdio.h>  
// Includes the Standard Input Output header file.
// Provides printf() function for printing output.
// Without this, the compiler wouldn't recognize printf().

int main()        
// Main function - the entry point of every C program.
// Execution always starts from here.
// 'int' means this function returns an integer value.

{                
// Opening curly brace - marks the beginning of the main function body.

    int i;        
    // Variable declaration: declares an integer variable named 'i'.
    // Memory is allocated for this variable on the stack.
    // Initially contains garbage value until assigned.

    for (i = 1; i <= 5; i++)  
    // 'for' loop: used for repetitive execution.
    // Three parts:
    // 1. i = 1  → Initialization: sets starting value to 1
    // 2. i <= 5 → Condition: loop continues while true
    // 3. i++   → Increment: increases i by 1 after each iteration

    {
        // Opening brace for for loop body.

        if (i == 3)  
        // 'if' statement: used for conditional execution.
        // Checks if the condition (i == 3) is true.
        // '==' is the equality operator (compares values).
        // If i is exactly 3, this condition becomes true.

        {
            // Opening brace for if block.
            
            continue;    
            // 'continue' statement: skips the current iteration.
            // When continue is executed, the remaining code in the loop body is skipped.
            // Control jumps directly to the increment (i++) and condition check.
            // Unlike break, it does NOT exit the loop completely.
            // It just skips one iteration and continues with the next.
            
        }
        // Closing brace for if block.

        printf("%d ", i);  
        // printf() prints formatted output to console.
        // "%d" - format specifier for integer.
        // " " (space) - prints a space after the number.
        // 'i' - the value to print.
        // This prints current value of i followed by a space.
        // NOTE: This line is SKIPPED when i == 3 because continue jumps here.

    }
    // Closing brace for for loop body.
    // After continue, control goes to i++ (increment) and then condition check.

    return 0;      
    // Return statement exits main() and returns 0 to OS.
    // 0 typically means program executed successfully.

}
// Closing curly brace - marks the end of main function.
// Program terminates here.



